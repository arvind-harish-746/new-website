{
  "name": "cybotz-landing",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n \"server,vite,images\" -c \"green,cyan,magenta\" \"tsx server/index.ts\" \"vite --host\" \"node scripts/watch-images.cjs\"",
    "dev:client": "concurrently -k -n \"vite,images\" -c \"cyan,magenta\" \"vite --host\" \"node scripts/watch-images.cjs\"",
    "dev:vite": "vite --host",
    "server": "tsx server/index.ts",
    "compress": "node scripts/compress-images.cjs",
    "compress:watch": "node scripts/watch-images.cjs",
    "prebuild": "node scripts/compress-images.cjs",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.0.0-alpha.4",
    "@react-three/fiber": "^9.0.0-alpha.8",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.6",
    "ogl": "^1.0.11",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7"
  }
}