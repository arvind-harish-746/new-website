# ==============================================================================
# CYBOTZ CONFIGURATION (.env)
# ==============================================================================

# 1. Google Apps Script Web App URL (Google Calendar Booking Engine)
# Get from Google Apps Script -> Deploy -> Web app URL
VITE_BOOKING_SCRIPT_URL=

# 2. MariaDB / MySQL Database Configuration (Native on Hostinger hPanel)
# In Hostinger: hPanel -> Databases -> MySQL Databases -> Create Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cybotz

# Alternatively, connection string:
# MYSQL_URI=mysql://username:password@localhost:3306/cybotz

# 3. Server Ports & Secrets
PORT=5000
JWT_SECRET=cybotz_super_secret_jwt_key_2026
